# Copy to .env. Nothing here is required for tests that don't call the LLM.
ANTHROPIC_API_KEY=
ADJUDICATE_DECIDE_MODEL=claude-opus-5-5
ADJUDICATE_DECIDE_EFFORT=high
ADJUDICATE_JUDGE_MODEL=claude-sonnet-5-5
ADJUDICATE_FAST_MODEL=claude-haiku-5-5

# Owner role runs migrations and seeding. App role is non-owner and subject to RLS.
ADJUDICATE_OWNER_DSN=postgresql://adjudicate_owner:owner_dev_pw@localhost:55432/adjudicate
ADJUDICATE_APP_DSN=postgresql://adjudicate_app:app_dev_pw@localhost:55432/adjudicate
ADJUDICATE_CHECKPOINT_DSN=postgresql://adjudicate_checkpoint:checkpoint_dev_pw@localhost:55432/adjudicate

# HS256 secret for tenant tokens and demo API keys. Development values only.
ADJUDICATE_TOKEN_SECRET=dev-only-secret-change-me-at-least-32-bytes
ADJUDICATE_MCP_URL=http://localhost:8765/mcp

# Tracing is off unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ADJUDICATE_ADMIN_DSN=postgresql://adjudicate_admin:admin_dev_pw@localhost:55432/adjudicate
